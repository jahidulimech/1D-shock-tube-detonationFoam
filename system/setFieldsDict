FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Eq. 28: (P,T,u) = (10 kPa, 278.7 K, 0)  for x > 0 cm   [right state, default]
//         (P,T,u) = (100 kPa, 348.4 K, 0) for x < 0 cm   [left state, boxToCell]

defaultFieldValues
(
    volScalarFieldValue p 10000
    volScalarFieldValue T 278.7
    volVectorFieldValue U (0 0 0)
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (0 1 1);

        fieldValues
        (
            volScalarFieldValue p 100000
            volScalarFieldValue T 348.4
            volVectorFieldValue U (0 0 0)
        );
    }
);

