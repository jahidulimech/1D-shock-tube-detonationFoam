FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      H2O;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0]; // Mass fraction

internalField   uniform 0; // Default (Initially zero in unburnt region)

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            empty;
    }
    top
    {
        type            empty;
    }
    frontAndBack
    {
        type            empty;
    }
}

